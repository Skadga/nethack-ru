/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_NETHACKW            ICON                    "NETHACK.ICO"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_NETHACKW MENU
BEGIN
    POPUP "&Файл"
    BEGIN
        MENUITEM "&Сохранить и выйти",              IDM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "&Выйти",                       IDM_EXIT
    END
    POPUP "&Карта"
    BEGIN
        MENUITEM "&0 - Плитки",              IDM_MAP_TILES
        MENUITEM "&1 - ASCII (4x6)",            IDM_MAP_ASCII4X6
        MENUITEM "&2 - ASCII (6x8)",            IDM_MAP_ASCII6X8
        MENUITEM "&3 - ASCII (8x8)",            IDM_MAP_ASCII8X8
        MENUITEM "&4 - ASCII (16x8)",           IDM_MAP_ASCII16X8
        MENUITEM "&5 - ASCII (7x12)",           IDM_MAP_ASCII7X12
        MENUITEM "&6 - ASCII  (8x12)",          IDM_MAP_ASCII8X12
        MENUITEM "&7 - ASCII (16x12)",          IDM_MAP_ASCII16X12
        MENUITEM "&8 - ASCII (12x16)",          IDM_MAP_ASCII12X16
        MENUITEM "&9 - ASCII  (10x18)",         IDM_MAP_ASCII10X18
        MENUITEM SEPARATOR
        MENUITEM "&По размеру окна",             IDM_MAP_FIT_TO_SCREEN
        MENUITEM SEPARATOR
        MENUITEM "&Копировать в буфер (ASCII)",  IDM_SETTING_SCREEN_TO_CLIPBOARD
        MENUITEM "&Сохранить в файл (ASCII)",       IDM_SETTING_SCREEN_TO_FILE
    END
    POPUP "Окна и &настройки"
    BEGIN
        MENUITEM "Режим NetHack",                IDM_NHMODE
        MENUITEM SEPARATOR
        MENUITEM "&Сбросить все настройки",         IDM_CLEARSETTINGS
        MENUITEM SEPARATOR
        MENUITEM "&Автоматически упорядочить окна",       IDM_SETTING_AUTOLAYOUT
        MENUITEM "&Зафиксировать окна",               IDM_SETTING_LOCKWINDOWS
    END
    POPUP "&Помощь"
    // 5.0: HELP_LONG and HELP_OPTIONS_LONG both used to specify &L as their
    // accelator.  Typing 'L' or 'l' highlighted one of the two, then <enter>
    // would execute it or typing another 'l' or 'L' would unhighlight the
    // currently highlit one and highlight the other.  All other accelerators
    // just run the relevant entry without needing <enter>.   HELP_LONG has
    // finally been changed to &g for "game".
    //
    // "// {...}" lines are placeholders for missing entries that are more
    // recent than this resource file.  The wizard mode one may need to
    // stay suppressed since it is conditional.
    BEGIN
        MENUITEM "&О программе ...",                  IDM_ABOUT
        MENUITEM "Полное &описание игры", IDM_HELP_LONG
        MENUITEM "&Список команд",           IDM_HELP_COMMANDS
        MENUITEM "&История NetHack",         IDM_HELP_HISTORY
        MENUITEM "&Информация о символе", IDM_HELP_INFO_CHAR
        MENUITEM "Информация о кла&више", IDM_HELP_INFO_KEY
        MENUITEM "Список &опций игры",       IDM_HELP_OPTIONS
        MENUITEM "&Полный список опций", IDM_HELP_OPTIONS_LONG
	// { dispfile_optmenu, "Using the %s command to set options." } //"'O'"
	// { dokeylist, "Full list of keyboard commands." }
        MENUITEM "Список расширенн&ых команд",  IDM_HELP_EXTCMD
	// { domenucontrols, "List menu control keys." }
        MENUITEM "Лицензия &NetHack",        IDM_HELP_LICENSE
	// { docontact, "Support information." }
        MENUITEM "Справка NetHack для &Windows",   IDM_HELP_PORTHELP
	// { dispfile_debughelp, "List of wizard-mode commands." }
    END
END


