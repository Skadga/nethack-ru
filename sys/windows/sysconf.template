# Образец файла sysconf.
# Файл sysconf используется, только если NetHack собран с SYSCF.
# Синтаксис такой же, как в nethack.cf.

# Кому разрешён режим WIZARD (отладка, флаг -D).
# Значение * разрешает отладочный режим всем.
WIZARDS=*

# Кому разрешена команда ! (выход в оболочку) и приостановка игры.
# Синтаксис тот же, что у параметра WIZARDS выше.
#SHELLERS=

# Запускать эту программу при каждом новом сообщении в окне сообщений.
# Программа получит текст сообщения единственным параметром.
#MSGHANDLER=\path\program

# Показывать отладочную информацию из этих исходных файлов.
# '*' — все файлы; иначе перечислите файлы через пробел.
# Доступно, только если игра собрана с DEBUG.
#DEBUGFILES=*

# Сохранять итоговый дамп игры в этот файл.
# Доступно, только если NetHack собран с DUMPLOG
# Допустимые подстановки:
#   %% сам символ '%'
#   %v версия (напр. "5.0.0-0")
#   %u UID игры
#   %t время начала игры, формат UNIX timestamp
#   %T текущее время, формат UNIX timestamp
#   %d время начала игры, формат YYYYMMDDhhmmss
#   %D текущее время, формат YYYYMMDDhhmmss
#   %n имя игрока
#   %N первый символ имени игрока
#DUMPLOGFILE=nethack-%n-%d.log

# Число пулов файлов bones.
# Пул определяется при старте игры. Читать и сохранять bones
# вы будете только в нём. Обычно нужно
# только для публичных серверов.
# Изменение может сделать существующие bones недоступными.
# Отключается значением 0 или комментарием.
#BONES_POOLS=10

# Ограничить число одновременных игр (см. также nethack.sh).
#MAXPLAYERS=10

# Если задано, добавляется к строке «To get local support, » в разделе
# помощи о поддержке.
#SUPPORT=call Izchak at extension 42.

# Раскомментируйте следующую строку, чтобы отключить SEDUCE.
#SEDUCE=0

# Раскомментируйте следующую строку, чтобы включить средства
# доступности: символы S_hero_override и S_pet_override для
# экранных дикторов в файле настроек игрока.
#ACCESSIBILITY=1

# Параметры файла рекордов.
# ВНИМАНИЕ: изменение после начала игры может
#  привести к потере рекордов!
# Максимум записей на одного человека.
#PERSMAX=10
# Максимум записей в файле рекордов.
#ENTRYMAX=100
# Минимум очков для попадания в список.
#POINTSMIN=1
# Определять "человека" в файле рекордов по имени (0) или
# числовому (1) идентификатору.
#PERS_IS_UID=1

# Меню помощи: 0 — показывать пункт "command line usage";
# 1 — скрыть его.  Не влияет на 'nethack --usage', если
# доступна командная строка.  Текст справки описывает
# обработку аргументов в UNIX, так что здесь он малополезен.
HIDEUSAGE=1

# Сколько записей из файла рекордов брать для имён случайных статуй
#MAX_STATUENAME_RANK=10

# 'portable_device_paths' поддерживается только в Windows.  Начиная с
# 3.6.3 NetHack в Windows считает папку с nethack.exe и nethackW.exe
# доступной только для чтения, а создаваемые или изменяемые
# во время игры и пользователем файлы данных размещает в папках,
# производных от имени пользователя.  3.6.4 добавила
# PORTABLE_DEVICE_PATHS, возвращающий прежнее поведение: файл настроек
# и данные лежат рядом с исполняемым файлом, и всю сборку можно
# переносить между машинами (флешка или облако) без правки путей.
# Раскомментируйте и задайте 1, чтобы включить.
#PORTABLE_DEVICE_PATHS=0

# *** РАСПОЛОЖЕНИЕ ФАЙЛОВ ***
# ВАЖНО: при изменении этих путей каталоги должны уже
# существовать.  NetHack не создаёт их.
#
# Перед правкой можно узнать пути по умолчанию командой:
#       nethack --showpaths
#
# Где игроки могут задать параметры запуска из своего файла настроек
#CONFIGDIR=%USERPROFILE%\NetHack
#
# Где хранится журнал аварийных завершений и самостоятельно
# найденных проблем (по умолчанию HACKDIR, нужна запись)
#TROUBLEDIR=%USERPROFILE%\NetHack\5.0
#
# Каталог документации и файлов помощи
#HACKDIR=%USERPROFILE%\NetHack\5.0
#
# Каталог текущих уровней (нужна запись)
#LEVELDIR=%USERPROFILE%\AppData\Local\NetHack\5.0
#
# Каталог сохранённых игр (нужна запись)
#SAVEDIR=%USERPROFILE%\AppData\Local\NetHack\5.0
#
# Каталог файлов bones (нужна запись)
#BONESDIR=c:\ProgramData\NetHack\5.0
#
# Каталог файлов рекордов (нужна запись)
#SCOREDIR=c:\ProgramData\NetHack\5.0
#
# Каталог блокировок синхронизации файлов (нужна запись)
#LOCKDIR=c:\ProgramData\NetHack\5.0

# Адрес, открываемый для отправки отчёта команде NetHack
#CRASHREPORTURL=https://nethack.org/links/cr-5.0.0.html
